      <aliases enabled='yes' />
      <column caption='Aware Respondents' datatype='integer' name='[Calculation_0288675759730688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [aware_of_event] = &apos;Yes&apos; THEN [respondent_id] END)' />
      </column>
      <column caption='Awareness' datatype='real' default-format='p0.00%' name='[Calculation_0288675759796225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0288675759730688] / COUNTD([respondent_id])' />
      </column>
      <column caption='Attendance Conversion' datatype='real' default-format='p0.00%' name='[Calculation_0288675759894530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [aware_of_event] = &apos;Yes&apos; AND [attended_event] = &apos;Yes&apos; THEN [respondent_id] END) &#13;&#10;/ &#13;&#10;[Calculation_0288675759730688]' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0288675760001027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 18 THEN &apos;Under 18&apos;&#13;&#10;ELSEIF [age] &gt;= 18 AND [age] &lt;= 24 THEN &apos;18-24&apos;&#13;&#10;ELSEIF [age] &gt;= 25 AND [age] &lt;= 34 THEN &apos;25-34&apos;&#13;&#10;ELSEIF [age] &gt;= 35 AND [age] &lt;= 44 THEN &apos;35-44&apos;&#13;&#10;ELSEIF [age] &gt;= 45 AND [age] &lt;= 54 THEN &apos;45-54&apos;&#13;&#10;ELSE &apos;55+&apos;&#13;&#10;END' />
      </column>
      <column caption='Respondent' datatype='integer' name='[Calculation_0288675760054276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([respondent_id])' />
      </column>
      <column caption='attended' datatype='integer' default-format='p0.00%' name='[Calculation_0288675761569797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [attended_event] = &apos;Yes&apos; THEN [respondent_id] END)' />
      </column>
      <column caption='Event attendance' datatype='real' default-format='p0.00%' name='[Calculation_0288675761897478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0288675761569797]/[Calculation_0288675760054276]' />
      </column>
